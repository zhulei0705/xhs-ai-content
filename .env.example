# MySQL / Redis
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=xhs_ai_content
DB_USERNAME=xhs_app
DB_PASSWORD=replace-with-strong-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# AI: mock / openai / deepseek / openrouter / compatible
XHS_AI_PROVIDER=mock
XHS_AI_BASE_URL=https://api.openai.com/v1
XHS_AI_API_KEY=
XHS_AI_MODEL=gpt-4.1-mini
XHS_AI_TEMPERATURE=0.7

# Web
SERVER_PORT=8080
XHS_CORS_ALLOWED_ORIGINS=http://localhost:5173
